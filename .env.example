# ============================================================
# VerdeScan Mobile - configuração opcional
#
# NÃO é preciso criar .env para rodar o app: sem ele, o app usa
# a API pública no Railway (veja src/config/api.ts) e, se a
# API estiver fora do ar, funciona com classificação manual.
#
# Para usar outra API, copie este arquivo para .env, preencha a
# variável abaixo e reinicie o Expo (npx expo start -c).
# ============================================================

# Endereço da VERDESCAN-API (sem barra no final). Exemplos:
#
# API pública no Railway (padrão):
#   EXPO_PUBLIC_API_URL=https://COLE-A-URL-DO-RAILWAY.up.railway.app
#
# API rodando no seu PC, testando pelo Expo Go no celular
# (use o IP do PC na rede Wi-Fi; veja com "ipconfig" no Windows):
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
#
# API no seu PC, testando no emulador Android:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# API no seu PC, testando no navegador (tecla w) ou no simulador iOS:
#   EXPO_PUBLIC_API_URL=http://localhost:8000

EXPO_PUBLIC_API_URL=
